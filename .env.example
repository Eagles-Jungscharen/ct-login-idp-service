# ========================================
# FRONTEND ENVIRONMENT VARIABLES
# ========================================
# Hinweis: Alle Frontend-Variablen müssen mit VITE_ prefixiert sein

# URL des IDP-Backends (ohne trailing slash)
VITE_LOGIN_SERVER_URL=https://your-churchtools-idp-server.com

# Titel der Login-Maske
VITE_APP_TITLE=ChurchTools Login

# Beschreibung unter dem Titel
VITE_APP_DESCRIPTION=Melden Sie sich mit Ihren ChurchTools-Zugangsdaten an

# URL zum Hintergrundbild (optional, kann leer sein)
VITE_BACKGROUND_IMAGE_URL=

# ========================================
# BACKEND ENVIRONMENT VARIABLES
# ========================================

# Azure Storage (lokal: Azurite)
AzureWebJobsStorage=UseDevelopmentStorage=true

# Azure Functions Runtime
FUNCTIONS_WORKER_RUNTIME=dotnet-isolated

# ChurchTools Instanz-URL
CT_URL=https://your-church.church.tools

# URL des Login-Clients (Frontend)
LOGIN_CLIENT_URL=http://localhost:5173

# Application Insights (optional für lokale Entwicklung)
APPLICATIONINSIGHTS_CONNECTION_STRING=
